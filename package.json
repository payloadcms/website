{
  "name": "payload-website",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:llms": "payload run src/scripts/generateLLMs.ts",
    "build": "pnpm generate:llms && pnpm payload migrate && cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "build:skipDocs": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "postbuild": "next-sitemap --config ./next-sitemap.config.cjs",
    "analyze": "ANALYZE=true next build --webpack",
    "caddy": "caddy run --config Caddyfile",
    "start": "next start",
    "lint": "eslint .",
    "prettier:fix": "prettier --write .",
    "migrate-lexical-script": "payload run ./src/migrate.ts"
  },
